{
  "name": "omp-launchpad",
  "version": "0.1.0",
  "description": "Launchpad resources and operations for Oh My Pi",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goulinkh/omp-launchpad.git"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "launchpad",
    "lpcli",
    "rust"
  ],
  "files": [
    "index.ts",
    "bin",
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    "src"
  ],
  "omp": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit && node --check scripts/package-release.mjs && cargo fmt --check && cargo clippy --all-targets --all-features -- -D warnings"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.1.19",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
